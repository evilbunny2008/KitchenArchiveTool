<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/spacer_1x">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/copyToAccountTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacer_2x"
        android:paddingTop="@dimen/spacer_2x"
        android:paddingEnd="@dimen/spacer_2x"
        android:paddingBottom="@dimen/spacer_1x"
        android:text="@string/copy_to_account_title"
        android:textColor="@color/textColor"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/accountList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:visibility="gone"
        tools:listitem="@layout/item_account_switcher" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/noOtherAccountsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacer_2x"
        android:paddingTop="@dimen/spacer_1x"
        android:paddingEnd="@dimen/spacer_2x"
        android:paddingBottom="@dimen/spacer_2x"
        android:text="@string/copy_to_account_none_available"
        android:textColor="@color/textColor"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadingIndicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacer_2x"
        android:layout_marginBottom="@dimen/spacer_2x"
        android:indeterminate="true" />

</LinearLayout>
