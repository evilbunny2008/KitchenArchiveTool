<?xml version="1.0" encoding="utf-8"?>
<!--
  KAT logo: a cat face wearing a chef's toque, same character as
  ic_launcher_foreground.xml, but scaled to fill this 108x108 viewport
  near edge-to-edge (scale 0.75, translate (-36, -19.875), centering the
  character's x:56..184 / y:32..165 bounding box in the 240-unit working
  space used to author it; see ic_launcher_foreground.xml for the full
  explanation of that coordinate system).

  Unlike the adaptive-icon foreground, this drawable doesn't need its
  own internal safe-zone margin: every place it's used (nav_header.xml,
  activity_login.xml, NotificationChannelManager's small icon) is an
  ImageView that already applies its own padding, so filling this
  viewport fully lets each caller control the final margin itself,
  matching how this file worked before (the previous book icon also
  filled the viewport edge-to-edge).

  Eyes, the nose, and the inner-ear notches are true holes (nested
  subpaths under android:fillType="evenOdd"), not a hardcoded second
  color, so they show through to whatever's actually behind this
  drawable (a plain colorPrimary background in nav_header/login, or
  nothing at all for the notification small icon, which Android renders
  from this file's alpha channel only, ignoring fillColor entirely).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <group
      android:scaleX="0.75"
      android:scaleY="0.75"
      android:translateX="-36"
      android:translateY="-19.875">

    <!-- Right ear: outer triangle, with inner-ear notch cut as a hole -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
          M144,102 L184,52 L174,126 Z
          M148,108 L170,76 L164,120 Z" />

    <!-- Left ear: outer triangle, with inner-ear notch cut as a hole -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
          M96,102 L56,52 L66,126 Z
          M92,108 L70,76 L76,120 Z" />

    <!-- Head, with both eyes and the nose cut as holes -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
          M70,132
          Q66,100 100,98
          Q120,94 140,98
          Q174,100 170,132
          Q176,168 120,180
          Q64,168 70,132
          Z
          M107.5,138 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z
          M143.5,138 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z
          M114,152 L126,152 L120,158 Z" />

    <!-- Mouth -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF0082C9"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="
          M120,158 Q118,165 107,165
          M120,158 Q122,165 133,165" />

    <!-- Whiskers -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="
          M110,156 L74,148
          M110,160 L74,160
          M110,164 L74,172
          M130,156 L166,148
          M130,160 L166,160
          M130,164 L166,172" />

    <!-- Chef's hat band -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
          M94,73
          L146,73
          A4,4 0 0 1 150,77
          L150,90
          A4,4 0 0 1 146,94
          L94,94
          A4,4 0 0 1 90,90
          L90,77
          A4,4 0 0 1 94,73
          Z" />

    <!-- Chef's hat puff: five overlapping circles forming a scalloped top -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
          M75,58 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 Z
          M92,51 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 Z
          M114,51 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 Z
          M135,58 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0 Z
          M104,48 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z" />

  </group>
</vector>
